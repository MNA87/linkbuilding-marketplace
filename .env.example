# --- Database (Railway Postgres) ---
DATABASE_URL="postgresql://user:password@host:5432/railway"

# --- Auth.js / NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- Stripe (Connect Express) ---
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
# https://dashboard.stripe.com/test/webhooks — endpoint: /api/stripe/webhook
# Events to send: checkout.session.completed, checkout.session.expired, account.updated
STRIPE_WEBHOOK_SECRET=""
# Set to "true" once real third-party publishers are onboarded. While unset/false,
# publisher self-registration is hidden, the per-item Stripe-onboarding checkout
# gate is skipped, and publisher order-notification emails aren't sent — the
# platform is assumed to only be selling the operator's own sites.
PUBLISHER_PAYOUTS_ENABLED="false"

# --- Resend (transactional email) ---
# https://resend.com/api-keys
RESEND_API_KEY=""
# Must be on a domain you've verified in Resend
EMAIL_FROM="Backlink Exchange <no-reply@yourdomain.nl>"

# --- File uploads (S3-compatible bucket, e.g. a Railway bucket) ---
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# --- Sentry (error tracking) ---
# https://sentry.io -> Settings -> Projects -> [project] -> Client Keys (DSN)
# Same DSN value in both — NEXT_PUBLIC_ is required for Next.js to expose
# it to the browser bundle for client-side error tracking.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Optional, only needed for sourcemap upload during `next build`:
SENTRY_ORG=""
SENTRY_PROJECT=""

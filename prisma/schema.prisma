// ---------------------------------------------------------------------------
// Prisma schema — Linkbuilding Marketplace
//
// Dit schema implementeert het datamodel uit Fase 3 van het bouwplan.
// Belangrijkste ontwerpregels:
//  1. Prijzen worden bevroren op het order_item (supplierPriceSnap /
//     customerPriceSnap / marginSnap) zodat latere prijswijzigingen bij de
//     publisher of in de marge-instellingen bestaande orders niet aanpassen.
//  2. Producten zijn generiek (Product + WebsiteProduct met een JSON
//     "config" veld) zodat een nieuw plaatsingstype later toegevoegd kan
//     worden zonder het schema om te gooien.
//  3. Role is een eigen tabel (i.p.v. een enum) zodat rollen zoals reseller,
//     agency of accountmanager later toegevoegd kunnen worden zonder
//     migratie van bestaande data.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------- Identiteit & rollen ---------------------------

model Role {
  id    String @id @default(cuid())
  name  String @unique // customer | supplier | admin | (later: reseller, agency, accountmanager)
  users User[]
}

enum CompanyType {
  CUSTOMER
  PUBLISHER
}

model Company {
  id        String      @id @default(cuid())
  name      String
  type      CompanyType
  createdAt DateTime    @default(now())

  // Stripe Connect Express account id — set once a PUBLISHER company
  // completes onboarding. Payouts for their orders are split to this
  // account via transfer_data on the PaymentIntent.
  stripeAccountId        String?
  stripeAccountOnboarded Boolean @default(false)

  // A customer ordering as a business: the invoices carry the company
  // name, its address and VAT number. Off for a private customer, whose
  // own name and address fill those in.
  isBusiness Boolean @default(true)

  // Invoice address of a customer company — required before checkout.
  billingAddress  String    @default("")
  billingPostcode String    @default("")
  billingCity     String    @default("")
  vatNumber       String?
  // Where the customer is based: NL, BE, DE, … or OTHER (asked at signup).
  country         String    @default("NL")
  // The VAT number checked with VIES (src/lib/vies.ts): none | valid |
  // review | approved | invalid, with what the register said and the
  // consultation number as proof. Decides "btw verlegd" (src/lib/vatRules.ts).
  vatStatus       String    @default("none")
  vatCheckedAt    DateTime?
  vatCheckName    String?
  vatCheckAddress String?
  vatCheckRef     String?

  // Prices agreed with this customer (Admin → Klanten → klant): a discount
  // on every site, a fixed price per site/product that goes before it, and
  // whether writing the article is included in that price.
  discountPercent Decimal?        @db.Decimal(5, 2)
  writingIncluded Boolean         @default(false)
  customerPrices  CustomerPrice[]

  users            User[]
  websites         Website[]
  projects         Project[]
  invoices         Invoice[]
  publisherPayouts PublisherPayout[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  status       String    @default("active") // active | suspended | deleted
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  passwordResetTokenHash    String?
  passwordResetTokenExpires DateTime?

  // Raised on a password change or reset and on a confirmed e-mail change:
  // every login made before then (on any device) stops working. The login
  // doing the change carries the new number on.
  sessionVersion Int @default(0)

  // Null until the registration link in sendVerificationEmail is clicked —
  // login is refused until then, to keep e.g. a mistyped email from ending
  // up as a permanent, unreachable account.
  emailVerifiedAt               DateTime?
  emailVerificationTokenHash    String?
  emailVerificationTokenExpires DateTime?

  // Optional, for contact about an order.
  phone          String?
  // "Waar ken je ons van?" at signup.
  referralSource String?

  // The customer's own address (Account → Mijn gegevens). What goes on the
  // invoices is the company's billing address below — for a private
  // customer (Company.isBusiness false) that's a copy of this one.
  address  String?
  postcode String?
  city     String?

  // A new e-mail address waiting to be confirmed through the link sent to
  // it; the login address only changes once that link is opened.
  pendingEmail             String?
  pendingEmailTokenHash    String?   @unique
  pendingEmailTokenExpires DateTime?

  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  orders Order[]

  inboundMails InboundMail[]
}

// ------------------------------ Site-instellingen ------------------------------

// Singleton row (id is always 1) — toggles the admin can flip without a
// code change/deploy, starting with whether the site is indexable.
model SiteSettings {
  id                  Int     @id @default(1)
  noindexEnabled      Boolean @default(true)
  // Off by default: a paid order's content publishes to WordPress only
  // after an admin reviews it manually (/admin/orders), rather than the
  // moment payment clears — a customer's article otherwise goes live on a
  // real site completely unreviewed.
  autoPublishEnabled  Boolean @default(false)
  // Action button colours across the whole app, set in Admin → Instellingen.
  payButtonColor      String  @default("#0d9488")
  primaryButtonColor  String  @default("#2563eb")
  primaryButtonFilled Boolean @default(true)
  // Heading colours of the customer menu's groups (Admin → Instellingen).
  menuColorBuy        String  @default("#2563eb")
  menuColorManage     String  @default("#7c3aed")
  menuColorAdmin      String  @default("#059669")
  // Colour per kind of link (icons and accents for blog / homepage links).

  // The seller on every invoice (Admin → Instellingen → Bedrijfsgegevens).
  // Copied onto each invoice when it's issued, so changing these later never
  // alters an invoice that was already sent.
  sellerName      String @default("")
  sellerAddress   String @default("")
  sellerPostcode  String @default("")
  sellerCity      String @default("")
  sellerKvk       String @default("")
  sellerVatNumber String @default("")
  sellerIban      String @default("")
  sellerEmail     String @default("")

  // Binnengekomen: your own addresses. A mail from one of these that was sent
  // on to the order mailbox is a forward; the customer is in the forwarded mail.
  ownEmails String[] @default([])

  // "Laat ons schrijven": what the article-writing service costs (excl. VAT).
  writingPrice Decimal @default(25) @db.Decimal(10, 2)

  // The hourly database backup (src/lib/databaseBackup.ts): how the last
  // attempt went, shown in Admin → Instellingen → Systeem, and when the
  // "no recent backup" warning was last mailed (at most once a day).
  backupLastRunAt       DateTime?
  backupLastDurationMs  Int?
  backupLastError       String?
  backupAlertSentAt     DateTime?
  // Off once Railway (Pro plan) makes the backups instead: then no hourly
  // copies or warnings, only the tidy-up of the copies still there.
  ownBackupsEnabled     Boolean   @default(true)
  // The last restore: which copy, when, and for the emergency route the
  // RESTORE_BACKUP value it was done for, so a restart never repeats it.
  restoredFrom          String?
  restoredAt            DateTime?
  emergencyRestoreValue String?

  // Admin → Planning: the day the platform is planned to go live.
  launchDate DateTime?
}

// An admin-edited override for one of the system's outgoing emails (see
// EMAIL_TEMPLATES in src/lib/email.ts for the fixed set of keys and their
// {{placeholder}} variables) — a row here means "use this instead of the
// built-in default text"; no row means the default still applies. Deleting
// a row (see adminResetEmailTemplateAction) is exactly how "reset to
// default" works.
// A point on Admin → Planning: something to finish before going live
// (list "livegang", in one of the steps 1-4 of src/lib/launch.ts), or an
// idea for afterwards (list "nice", step 0).
model LaunchItem {
  id        String   @id @default(cuid())
  list      String
  step      Int      @default(0)
  title     String
  // Extra explanation under the title, e.g. what to ask the accountant.
  note      String?
  // todo | busy | done | skip ("Laten zo": left as it is, not counted)
  status    String   @default("todo")
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([list, step, position])
}

model EmailTemplate {
  key       String   @id
  subject   String
  bodyHtml  String
  updatedAt DateTime @updatedAt
}

// ------------------------------ Stamdata ------------------------------

model Category {
  id   String @id @default(cuid())
  name String @unique

  websites     Website[]
  pricingRules PricingRule[]
}

model Country {
  id   String @id @default(cuid())
  name String @unique
  code String @unique

  websites Website[]
}

model Language {
  id   String @id @default(cuid())
  name String @unique
  code String @unique

  websites Website[]
}

// --------------------------- Marktplaats-inventaris ---------------------------

enum WebsiteStatus {
  SUBMITTED
  APPROVED
  ACTIVE
  PAUSED
  REJECTED
}

model Website {
  id          String        @id @default(cuid())
  domain      String        @unique
  description String?
  status      WebsiteStatus @default(SUBMITTED)
  createdAt   DateTime      @default(now())

  // Set when this site's content should auto-publish via the WordPress REST
  // API on order payment, instead of waiting on a manual "mark as live".
  // wordpressAppPassword is a WP Application Password (Users -> Profile),
  // not the account login password.
  wordpressUrl         String?
  wordpressUsername    String?
  wordpressAppPassword String?

  // Optional: when a host's bot protection blocks inbound automated
  // requests outright — seen with SiteGround's AI Anti-Bot Protection,
  // which turned out to block ANY unrecognized POST regardless of path —
  // publishing flips direction instead: a small WordPress plugin
  // (wordpress-plugin/nugevonden-wp-sync.php) polls Nugevonden FROM the
  // site itself (an outbound call WordPress already makes for things like
  // its own update checks, which host-level inbound protection doesn't
  // touch) and creates the post locally. Set only when that plugin is
  // installed on the target site; otherwise the regular REST API +
  // Application Password push is used.
  wpSyncSecret String? @unique

  // Set every time the site's own sync plugin reports its WordPress
  // categories back (see /api/wp-sync/categories) — lets Admin show
  // whether the category list below is fresh, since it's never typed in
  // by hand.
  wpCategoriesSyncedAt DateTime?

  // The site's own WordPress permalink setting (e.g. "/%postname%/" or
  // "/%category%/%postname%/") and home URL, reported by the sync plugin.
  // Null until a plugin version that reports them has synced. Decides
  // whether a blog order needs a category at all, and powers the "URL na
  // plaatsing" preview in the order form.
  wpPermalinkStructure String?
  wpHomeUrl            String?
  // A fixed start of every article URL on this site, when its URLs don't
  // follow from the permalink setting alone — e.g. nugevonden.nl, whose
  // articles all live under "https://nugevonden.nl/internet/".
  articleUrlBase       String?

  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  countryId  String
  country    Country  @relation(fields: [countryId], references: [id])
  languageId String
  language   Language @relation(fields: [languageId], references: [id])

  metrics         WebsiteMetric[]
  websiteProducts WebsiteProduct[]
  wpCategories    WpCategory[]

  inboundMails InboundMail[]

  @@index([status])
  @@index([categoryId])
}

// A WordPress category on this specific site (e.g. "Nieuws", term ID 4 in
// that site's own wp-admin) — unrelated to this platform's own Category
// taxonomy above, which classifies the website itself for the marketplace.
// Populated automatically: the site's own WP Sync plugin reports its
// categories on every sync cycle (see /api/wp-sync/categories) — never
// typed in by hand, since every site here sits behind hosting-level bot
// protection that would block us fetching them directly. A customer picks
// one of these when ordering so their article lands in the right place.
model WpCategory {
  id       String      @id @default(cuid())
  wpTermId Int
  name     String
  // Blog categories (WordPress's built-in "Categorieën") and homepage-link
  // rubrieken (a separate custom taxonomy the plugin registers, see
  // nugevonden_link_categorie) are deliberately two different lists — a
  // startpagina rubriek like "SEO" or "Interieur" has nothing to do with
  // how the blog itself is organized. Reuses ProductType rather than a
  // dedicated enum since it's the exact same distinction.
  kind     ProductType @default(BLOG_POST)

  websiteId String
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, wpTermId, kind])
}

model WebsiteMetric {
  id               String   @id @default(cuid())
  domainRating     Int
  domainAuthority  Int
  organicTraffic   Int
  referringDomains Int
  // Fetched automatically (source "auto", src/lib/websiteMetrics.ts): TF
  // and CF from Majestic, spam score from Moz, and the site's IP address.
  trustFlow        Int?
  citationFlow     Int?
  spamScore        Int?
  ipAddress        String?
  behindCloudflare Boolean  @default(false)
  // Whether Google's AI (AI Overviews / AI Mode) cites the site as a source;
  // null when not known. Not fetched yet: Ahrefs needs its Brand Radar add-on.
  aiCited          Boolean?
  source           String   @default("manual") // manual | auto
  fetchedAt        DateTime @default(now())

  websiteId String
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
}

// ------------------------- Producten (generiek, uitbreidbaar) -------------------------

enum ProductType {
  BLOG_POST
  HOMEPAGE_LINK
  // Toekomstige types (niche edit, press release, ...) kunnen hier simpelweg
  // bij, zonder dat WebsiteProduct.config van vorm hoeft te veranderen.
}

model Product {
  id   String      @id @default(cuid())
  type ProductType @unique
  name String

  websiteProducts WebsiteProduct[]
}

model WebsiteProduct {
  id            String  @id @default(cuid())
  supplierPrice Decimal @db.Decimal(10, 2)
  isAvailable   Boolean @default(true)
  // Type-specifieke instellingen (min/max woorden, dofollow, positie,
  // looptijd, toegestane onderwerpen, ...). Bewust JSON zodat nieuwe
  // producttypes geen kolommen nodig hebben.
  config        Json

  websiteId String
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  orderItems     OrderItem[]
  pricingRules   PricingRule[]
  customerPrices CustomerPrice[]

  @@unique([websiteId, productId])
}

// A fixed price for one customer on one site/product, agreed with them;
// it goes before the customer's discount and the standard price.
model CustomerPrice {
  id               String         @id @default(cuid())
  price            Decimal        @db.Decimal(10, 2)
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  websiteProductId String
  websiteProduct   WebsiteProduct @relation(fields: [websiteProductId], references: [id], onDelete: Cascade)

  @@unique([companyId, websiteProductId])
}

// Admin kan globaal, per categorie, of per website/product de marge
// overschrijven. Een handmatige customerPrice wint altijd van de
// percentage-marge.
model PricingRule {
  id                   String   @id @default(cuid())
  defaultMarginPercent Decimal  @db.Decimal(5, 2)
  manualCustomerPrice  Decimal? @db.Decimal(10, 2)
  createdAt            DateTime @default(now())

  websiteProductId String?
  websiteProduct   WebsiteProduct? @relation(fields: [websiteProductId], references: [id])
  categoryId       String?
  category         Category?       @relation(fields: [categoryId], references: [id])
}

// ------------------------------ Projecten & orders ------------------------------

model Project {
  id            String   @id @default(cuid())
  name          String
  targetWebsite String?
  notes         String?
  createdAt     DateTime @default(now())

  customerCompanyId String
  customerCompany   Company @relation(fields: [customerCompanyId], references: [id])

  orders Order[]
}

enum OrderStatus {
  NEW
  PAID
  SENT_TO_PUBLISHER
  ACCEPTED
  IN_PROGRESS
  PUBLISHED
  VERIFICATION
  COMPLETED
  REJECTED
  CANCELLED
  REFUND_REQUESTED
}

model Order {
  id          String      @id @default(cuid())
  // A short, human-friendly number for the admin overview — the cuid `id`
  // stays the real key everywhere else (URLs, relations), this is purely
  // display so an order can be referred to as "#42" instead of a long
  // string of letters and digits.
  orderNumber Int         @unique @default(autoincrement())
  status      OrderStatus @default(NEW)
  createdAt   DateTime    @default(now())
  paidAt      DateTime?
  // Set when the admin manually archives this order from the overview to
  // keep it clean — independent of status, since an order can be done in
  // every practical sense without ever reaching a terminal status.
  archivedAt  DateTime?
  // VAT percentage fixed at checkout (e.g. 21). 0 for orders paid before VAT
  // was charged — their totals stay exactly what was paid.
  vatRate     Decimal     @default(0) @db.Decimal(5, 2)
  // Why no Dutch VAT was charged: reverse (btw verlegd) | outside_eu.
  vatNote     String?
  // Ordered by mail and paid afterwards: no checkout, the order goes on the
  // customer's monthly collective invoice instead (Admin → Binnengekomen).
  onAccount   Boolean     @default(false)

  customerId String
  customer   User    @relation(fields: [customerId], references: [id])
  projectId  String
  project    Project @relation(fields: [projectId], references: [id])

  items    OrderItem[]
  payments Payment[]
  invoices Invoice[]
  messages OrderMessage[]
}

enum ContentSource {
  CUSTOMER
  PUBLISHER
}

model OrderItem {
  id String @id @default(cuid())

  // --- bevroren prijzen: nooit herberekenen uit actuele instellingen ---
  supplierPriceSnap Decimal @db.Decimal(10, 2)
  customerPriceSnap Decimal @db.Decimal(10, 2)
  marginSnap        Decimal @db.Decimal(5, 2)

  // A link was never required — the customer places one themselves in the
  // article text (select text, click the link icon) if they want one at
  // all; an order can just be content with no backlink.
  targetUrl       String?
  anchorText      String?
  // Dofollow (the default — passes SEO value) vs nofollow, chosen by the
  // customer at order time. Applied as a rel="nofollow" on the <a> tag,
  // both in an article's inline link and a homepage-link's listing.
  nofollow        Boolean        @default(false)
  comments        String?
  contentSource   ContentSource?
  articleTitle    String?
  articleBody     String?
  uploadedFileUrl String?
  articleImageKey String?
  // The last part of the article's URL (WordPress's post_name), when the
  // admin chose one; otherwise it's made from the title (src/lib/wpSlug.ts).
  articleSlug     String?

  // Set once this item should go out to WordPress — either automatically
  // (auto-publish is on) or by an admin explicitly queuing it from
  // Admin -> Orders. For a site synced via the WP Sync plugin (see
  // Website.wpSyncSecret), this is what the site itself checks for on its
  // next poll; for a direct-API site it's set right before the push.
  readyToPublish Boolean @default(false)
  // The admin changed something that's already on the site: the site picks
  // the new version up on its next sync and clears this (/api/wp-sync/ack).
  updatePending  Boolean @default(false)

  // Which WordPress category (on the target site) this article should be
  // filed under — snapshotted at order time from WpCategory, same as the
  // price fields above, so a category the admin later renames or removes
  // doesn't change what an already-placed order says or publish to.
  wpTermId           Int?
  wpCategoryNameSnap String?

  // How long the placement stays online (1-3 years). The price snapshots
  // above are already for the whole period: yearly price x durationYears.
  durationYears  Int       @default(1)
  // "Wanneer online?" — null = straight after payment; otherwise the item is
  // held back until this moment (see /api/wp-sync/pending).
  publishAt      DateTime?
  // "Laat ons schrijven": the platform writes the article around the
  // customer's links (briefLinks: [{ anchor, url }], 1-2 of them) for an
  // extra writingFeeSnap on top of the placement price.
  writeForMe     Boolean   @default(false)
  briefLinks     Json?
  writingFeeSnap Decimal   @default(0) @db.Decimal(10, 2)

  // "Preview naar klant": the article sent as a Word file for approval.
  previewVersion Int       @default(0)
  previewSentAt  DateTime?

  // Paid for before its content was filled in ("Nu betalen, later
  // aanleveren"): how many reminders the customer has had so far — see
  // CONTENT_REMINDER_DAYS in src/lib/awaitingContent.ts.
  contentReminderCount Int @default(0)

  // Set on a renewal: this item buys extra years for that (earlier) item's
  // placement instead of placing anything new.
  renewsOrderItemId String?
  renewsOrderItem   OrderItem?  @relation("Renewal", fields: [renewsOrderItemId], references: [id])
  renewals          OrderItem[] @relation("Renewal")

  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  websiteProductId String
  websiteProduct   WebsiteProduct @relation(fields: [websiteProductId], references: [id])

  placement Placement?

  // The mail it was ordered by, the customer's replies, and the previews sent.
  inboundMails  InboundMail[]
  outboundMails OutboundMail[]
}

// A question or answer about an order, between the customer and the
// platform (Mijn orders "Reacties" ↔ Admin → Berichten). readAt: when the
// other side saw it — drives the "nieuwe reactie" markers and red counts.
model OrderMessage {
  id        String    @id @default(cuid())
  body      String
  fromAdmin Boolean
  createdAt DateTime  @default(now())
  readAt    DateTime?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Placement {
  id             String    @id @default(cuid())
  liveUrl        String?
  publishedAt    DateTime?
  verifiedAt     DateTime?
  status         String    @default("pending")
  // End of the paid period (publishedAt + durationYears, extended by
  // renewals). Null for placements from before periods existed: no end.
  expiresAt      DateTime?
  reminderSentAt DateTime?
  // When the site confirmed it took the placement offline after expiry.
  expiredAt      DateTime?
  // When the customer got the "staat live" mail that named this link. The
  // links of one order that go live together share one mail (see
  // sendLiveMails in src/lib/liveMails.ts).
  liveMailSentAt DateTime?

  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

// ------------------------------ Financieel ------------------------------

model Payment {
  id          String   @id @default(cuid())
  provider    String   @default("stripe")
  providerRef String?
  amount      Decimal  @db.Decimal(10, 2)
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])
}

model Invoice {
  id               String      @id @default(cuid())
  invoiceNumber    String      @unique
  type             InvoiceType @default(INVOICE)
  // Excl. VAT, the VAT on top, and `amount` = the total incl. VAT. For a
  // CREDIT invoice all three are negative.
  subtotal         Decimal     @default(0) @db.Decimal(10, 2)
  vatRate          Decimal     @default(0) @db.Decimal(5, 2)
  vatAmount        Decimal     @default(0) @db.Decimal(10, 2)
  amount           Decimal     @db.Decimal(10, 2)
  pdfUrl           String?
  issuedAt         DateTime    @default(now())
  // Seller and customer details as they were when the invoice was issued
  // (see src/lib/invoices.ts) — null on invoices from before this existed.
  sellerDetails    Json?
  customerDetails  Json?
  // A CREDIT invoice points at the invoice it cancels.
  creditsInvoiceId String?
  creditsInvoice   Invoice?    @relation("CreditInvoice", fields: [creditsInvoiceId], references: [id])
  creditInvoices   Invoice[]   @relation("CreditInvoice")

  customerCompanyId String
  customerCompany   Company @relation(fields: [customerCompanyId], references: [id])
  orderId           String
  order             Order   @relation(fields: [orderId], references: [id])

  @@unique([orderId, type])
}

enum InvoiceType {
  INVOICE
  CREDIT
}

// Last invoice number handed out per year — invoice numbers must run on
// without gaps (20260001, 20260002, ...), see allocateInvoiceNumber.
model InvoiceCounter {
  year Int @id
  last Int @default(0)
}

model PublisherPayout {
  id          String    @id @default(cuid())
  amount      Decimal   @db.Decimal(10, 2)
  periodStart DateTime
  periodEnd   DateTime
  status      String    @default("pending")
  paidAt      DateTime?

  supplierCompanyId String
  supplierCompany   Company @relation(fields: [supplierCompanyId], references: [id])
}

// An external service's API key, set in Admin → Instellingen → Koppelingen.
// Stored encrypted (src/lib/secretBox.ts); only its last characters are
// ever shown again.
model ApiCredential {
  provider   String   @id // ahrefs | seometrics | mailbox (the order mailbox, as JSON)
  ciphertext String
  last4      String
  updatedAt  DateTime @updatedAt
}

// Admin → Binnengekomen: a mail to the order mailbox, fetched over IMAP,
// with what could be read from it (customer, site, the Word article, links).
model InboundMail {
  id          String   @id @default(cuid())
  // The Message-ID header, so a mail is only taken in once.
  messageId   String   @unique
  fromEmail   String
  fromName    String?
  // Set when you forwarded the customer's mail: then the sender above is
  // the customer from the forwarded mail, and this is you.
  forwardedBy String?
  subject     String
  text        String   @default("")
  receivedAt  DateTime
  createdAt   DateTime @default(now())
  status      String   @default("new") // new | ignored | done

  // Recognised by the sender's address and by a site named in the mail.
  customerId String?
  customer   User?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  websiteId  String?
  website    Website? @relation(fields: [websiteId], references: [id], onDelete: SetNull)

  // From a Word attachment: the title and the article (sanitised HTML).
  articleTitle String?
  articleBody  String?
  // [{ anchor, url }] found in the article or the mail.
  links        Json     @default("[]")
  // Names of all attachments, read or not.
  attachments  String[] @default([])

  // One request of several in the mail ("Aanvraag 1/2", from a partner such
  // as Traffic Today), with its Google Doc and the partner's details.
  requestLabel String?
  docUrl       String?
  docError     String?
  endClient    String?
  externalRef  String?
  quotedPrice  Decimal? @db.Decimal(10, 2)

  // The order made from it, or the order a reply belongs to (matched on
  // In-Reply-To / References against the mails sent from the order).
  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  inReplyTo   String?
  // A customer's answer in the thread of an order (not a new order).
  isReply     Boolean    @default(false)

  @@index([status, receivedAt])
}

// A mail the platform sent from the order mailbox (a Word preview), kept so
// the customer's answer finds its way back to the order.
model OutboundMail {
  id          String    @id @default(cuid())
  messageId   String    @unique
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  toEmail     String
  subject     String
  version     Int
  sentAt      DateTime  @default(now())

  @@index([orderItemId])
}
